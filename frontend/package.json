{
  "name": "ep-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:admin": "turbo run dev --filter=@ep/admin-web",
    "dev:portal": "turbo run dev --filter=@ep/portal-web",
    "dev:knowledge-admin": "turbo run dev --filter=@ep/knowledge-admin",
    "dev:h5": "turbo run dev --filter=@ep/student-h5",
    "dev:knowledge-h5": "turbo run dev --filter=@ep/knowledge-h5",
    "dev:mp": "turbo run dev:mp --filter=@ep/student-mp",
    "dev:knowledge-mp": "turbo run dev --filter=@ep/knowledge-mp",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gen:api": "turbo run gen:api --filter=api-client"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "babel-preset-taro": "4.0.9",
    "turbo": "2.5.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/preset-react": "^7.29.7"
  }
}

# A-15: Exact version pins for reproducible builds
# All dependencies must use exact versions (no ^ or ~)
save-exact=true
save-prefix=

# C-09: Self-hosted Turborepo remote cache (PIPL compliance, no Vercel cloud)
# Configured in turbo.json, not here

# Engine pinning
engine-strict=true
verify-deps-before-run=false

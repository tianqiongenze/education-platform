    "@ep/shared": "workspace:*",
    "@ep/ui-kit": "workspace:*",
    "antd": "5.23.4",
    "@ant-design/icons": "5.6.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.5",
    "@tanstack/react-query": "5.101.4",
    "dayjs": "1.11.13"
  },
  "devDependencies": {
    "@ep/lint-config": "workspace:*",
    "eslint": "9.18.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.3",
    "vite": "6.0.11",
    "vitest": "2.1.9",
    "jsdom": "25.0.1",
    "@testing-library/react": "16.1.0",

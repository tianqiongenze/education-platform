{
  "name": "@ep/portal-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3004",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3004",

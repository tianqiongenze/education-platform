{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {},
    "e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:mp": {
      "cache": false,
      "persistent": true
    },
    "gen:api": {
      "outputs": ["packages/api-client/src/generated/**"],
      "cache": true,
      "inputs": ["packages/api-client/schemas/**", "packages/api-client/openapi-generator.config.yaml"]
    }
  }
}

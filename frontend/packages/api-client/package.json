  },
  "dependencies": {
    "@ep/shared": "workspace:*",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@ep/lint-config": "workspace:*",
    "eslint": "9.18.0",
    "@openapitools/openapi-generator-cli": "2.15.3",
    "typescript": "5.8.3",
    "vitest": "2.1.9"
  }
}

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
  </parent>
  <groupId>com.ep</groupId>
  <artifactId>core-business</artifactId>
  <version>1.0.0</version>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- D-115: JIB build port (core-business listens on 8083). -->
    <jib.container.port>8083</jib.container.port>
  </properties>
  <dependencies>
    <!-- ep-web-common: shared HTTP/security infrastructure (RoleChecker,
         ForbiddenException, ErrorResponse, GlobalExceptionHandler).
         Replaces 6 copy-pasted versions across sp03/sp05/sp07. -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>ep-web-common</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-tomcat</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jetty</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- P1-4: Actuator endpoint security (HTTP Basic for /actuator/** non-health/info). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- P2-9: Bean Validation (@Valid + @Validated on request DTOs). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- D-120: Spring Boot 4.0 split @DataJpaTest into its own module
         (spring-boot-starter-data-jpa-test). Required for the JPA slice
         repository tests under src/test/java/com/ep/business/**. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-spring-boot-starter</artifactId>
      <version>3.3.6</version>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo</artifactId>
      <version>3.3.6</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.nacos</groupId>
      <artifactId>nacos-client</artifactId>
      <version>3.1.1</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-core</artifactId>
      <version>1.8.9</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-annotation-aspectj</artifactId>
      <version>1.8.9</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-apache-dubbo3-adapter</artifactId>
      <version>1.8.9</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-transport-simple-http</artifactId>
      <version>1.8.9</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pulsar</groupId>
      <artifactId>pulsar-client</artifactId>
      <version>3.3.9</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.1</version>
    </dependency>
    <!-- D-066: Jackson JSR-310 (Instant) support for serializing domain events to Pulsar -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.19.4</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
      <version>3.51.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seata</groupId>
      <artifactId>seata-spring-boot-starter</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.14.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.18.0</version>
      <scope>test</scope>
    </dependency>
    <!-- D-076: gson required by Dubbo 3.3.6 / Nacos client 3.1.1 (NacosDynamicConfiguration uses gson for config deserialization).
         Previously transitive via springdoc; after removing springdoc it must be explicit. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    <!-- D-070: springdoc-openapi temporarily replaced with swagger-models-jakarta directly.
         springdoc 2.8.13 references org.springframework.data.util.TypeInformation which SB4 moved
         to org.springframework.data.core, causing NoClassDefFoundError during Dubbo bean scanning.
         swagger-models-jakarta provides the io.swagger.v3.oas.models.* classes that OpenApiConfig needs. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-models-jakarta</artifactId>
      <version>2.2.36</version>
    </dependency>
    <!-- D-070: Structured JSON logging for Loki/ELK ingestion -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>8.0</version>
    </dependency>
    <!-- P1: Resilience4j circuit breaker for downstream service calls -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
      <version>2.2.0</version>
    </dependency>
    <!-- D-108: H2 in-memory DB for the dev-local profile (zero-infra standalone boot). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- D-136: ArchUnit — architecture rule enforcement (DDD layering, no cycles). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- D-032: BFF (com.ep:portal-bff) 通过 Maven 依赖引用本模块的 Dubbo 接口与 DTO.
               repackage 产出的 fat jar 把业务类藏在 BOOT-INF/classes 下, 不可作为库被消费.
               classifier=exec 让可执行 fat jar 只占 core-business-1.0.0-exec.jar,
               普通 install 产物 core-business-1.0.0.jar 保留扁平布局供 BFF 引用. -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <!-- D-137: Coverage gate. haltOnFailure=false keeps Maven advisory locally;
               CI (java-test.yml coverage-gate job) enforces the hard 50% gate. -->
          <execution>
            <id>jacoco-check</id>
            <goals><goal>check</goal></goals>
            <phase>test</phase>
            <configuration>
              <haltOnFailure>false</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.50</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- D-040: GraalVM Native Image support -->
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <version>0.10.4</version>
        <configuration>
          <buildArgs>
            <buildArg>--enable-preview</buildArg>
            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
            <buildArg>--initialize-at-build-time=org.slf4j,com.fasterxml.jackson</buildArg>
            <buildArg>--trace-class-initialization=com.ep.**</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
      <!-- D-136: PITest mutation testing (nightly via mutation-test.yml).
           Only the core domain package (com.ep.business.course + user) is
           mutated to keep runtime manageable. Java 21 needs
           -XX:+EnableDynamicAgentLoading to silence the dynamic-agent warning. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.16.1</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.ep.business.course.*</param>
            <param>com.ep.business.user.*</param>
          </targetClasses>
          <targetTests>
            <param>com.ep.business.*</param>
          </targetTests>
          <jvmArgs>
            <value>-XX:+EnableDynamicAgentLoading</value>
          </jvmArgs>
          <outputFormats>
            <format>XML</format>
            <format>HTML</format>
          </outputFormats>
          <timeoutConstant>5000</timeoutConstant>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- D-115: JIB container image build profile.
       Activated with: mvn compile jib:build -Pjib-build
       Shared profile snippet: deploy/build/jib-pom-profile.xml
       Image: harbor.edu.internal/education-platform/core-business:1.0.0 -->
  <profiles>
    <profile>
      <id>jib-build</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <version>3.4.4</version>
            <configuration>
              <to>
                <image>harbor.edu.internal/education-platform/${project.artifactId}:${project.version}</image>
              </to>
              <from>
                <image>eclipse-temurin:21-jre-alpine</image>
              </from>
              <container>
                <ports>
                  <port>${jib.container.port}</port>
                </ports>
                <jvmFlags>
                  <jvmFlag>-XX:+UseZGC</jvmFlag>
                  <jvmFlag>-XX:+ZGenerational</jvmFlag>
                  <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                  <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
                </jvmFlags>
                <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                <labels>
                  <org.opencontainers.image.source>${env.GIT_URL}</org.opencontainers.image.source>
                  <org.opencontainers.image.revision>${env.GIT_COMMIT}</org.opencontainers.image.revision>
                  <maintained-by>gitops</maintained-by>
                </labels>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

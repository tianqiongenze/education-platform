<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ep</groupId>
    <artifactId>order-platform</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>order-platform-service</artifactId>
  <packaging>jar</packaging>
  <name>Order Service</name>

  <properties>
    <!-- D-115: JIB build port (order-platform-service listens on 8084). -->
    <jib.container.port>8084</jib.container.port>
    <!-- D-195: unified Pulsar version (upgrade target 4.0 / 2027 Q1) -->
    <pulsar.version>3.3.9</pulsar.version>
  </properties>

  <dependencies>
    <!-- Thin RPC contract (this module implements com.ep.order.api.OrderService). -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>order-platform-api</artifactId>
    </dependency>

    <!-- OPM Payment Dubbo contract. OrderServiceImpl calls PaymentService over
         RPC via @DubboReference. This artifact is produced by the independent
         payment-platform middle platform; it must be `mvn install`-ed before this
         module compiles. -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>payment-platform-api</artifactId>
    </dependency>

    <!-- D-218: core-business Dubbo contract (com.ep.business.course.CourseService)
         for server-side order amount verification. createOrder resolves the
         authoritative course price over RPC (fail-closed) instead of trusting
         the client-supplied amount. -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>core-business</artifactId>
    </dependency>

    <!-- ep-web-common: shared RoleChecker / ForbiddenException / ErrorResponse /
         GlobalExceptionHandler (version from parent dependencyManagement). -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>ep-web-common</artifactId>
    </dependency>

    <!-- D-216: Disruptor multi-stage pipeline (order-events outbox). Provided
         only as a compile dependency; default-OFF via ep.disruptor.enabled=false
         so synchronous Pulsar publish behaviour is unchanged until production
         opts in. -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>ep-disruptor</artifactId>
      <version>1.0.0</version>
    </dependency>

    <!-- D-216: ep-data read/write-split datasource routing (HikariCP dual pool +
         EpRoutingDataSource + LazyConnectionDataSourceProxy). Opt-in via
         ep.data.enabled=true; when disabled (default) this service's own
         DataSource auto-config is untouched. -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>ep-data</artifactId>
      <version>1.0.0</version>
    </dependency>

    <!-- D-182: Multi-level cache SDK (L1 Caffeine + L2 Redis + Pub/Sub broadcast).
         spring-boot-starter-data-redis is required because ep-cache's CacheService
         references RedisTemplate in its constructor signature; Mockito needs the
         class on the classpath to create a mock of CacheService. -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>ep-cache</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-tomcat</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jetty</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- P1-4: Actuator endpoint security (HTTP Basic for /actuator/** non-health/info). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- P2-9: Bean Validation (@Valid + @Validated on request DTOs). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Dubbo -->
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-spring-boot-starter</artifactId>
      <version>${dubbo.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo</artifactId>
      <version>${dubbo.version}</version>
    </dependency>

    <!-- Nacos client (registry / config; gson-driven config deserialization). -->
    <dependency>
      <groupId>com.alibaba.nacos</groupId>
      <artifactId>nacos-client</artifactId>
      <version>3.1.1</version>
    </dependency>

    <!-- Pulsar client (domain-event publishing, EP_DEV_ONLY-guarded). -->
    <dependency>
      <groupId>org.apache.pulsar</groupId>
      <artifactId>pulsar-client</artifactId>
      <version>${pulsar.version}</version>
    </dependency>

    <!-- Jackson (domain-event serialization to Pulsar). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.19.4</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.19.4</version>
    </dependency>

    <!-- JPA + MySQL -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- D-182: Redis for ep-cache L2 backend (ep-cache declares it as 'provided',
         so it must be pulled in directly by each consumer). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- Seata global transactions.
         AT mode: @GlobalTransactional for short single-service transactions
         (retained as fallback; see ADR D-113).
         D-113: Saga mode for the long-running order -> stock -> payment flow.
         seata-saga-starter provides StateMachineEngine + @SagaCompensable
         support driven by the JSON definitions under src/main/resources/saga/. -->
    <dependency>
      <groupId>io.seata</groupId>
      <artifactId>seata-spring-boot-starter</artifactId>
      <version>2.0.0</version>
    </dependency>
    <!-- D-113: Saga state-machine engine. Seata 2.x does not publish a
         seata-saga-starter uber-jar; the StateMachineEngine is assembled
         from seata-saga-engine (engine core), seata-saga-statelang (JSON
         state-language parser), seata-saga-tm (transaction manager), and
         seata-saga-engine-store (persistence). See SagaStateMachineConfig
         which wires these into a StateMachineEngine bean. -->
    <dependency>
      <groupId>io.seata</groupId>
      <artifactId>seata-saga-engine</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>io.seata</groupId>
      <artifactId>seata-saga-statelang</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>io.seata</groupId>
      <artifactId>seata-saga-tm</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>io.seata</groupId>
      <artifactId>seata-saga-engine-store</artifactId>
      <version>2.0.0</version>
    </dependency>

    <!-- P1: Resilience4j circuit breaker for downstream service calls -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
      <version>2.2.0</version>
    </dependency>

    <!-- D-070: swagger-models-jakarta provides io.swagger.v3.oas.models.* for
         OpenApiConfig without pulling springdoc (which trips SB4 package moves). -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-models-jakarta</artifactId>
      <version>2.2.36</version>
    </dependency>

    <!-- D-070: Structured JSON logging for Loki/ELK ingestion -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>8.0</version>
    </dependency>

    <!-- D-076: gson required by Dubbo 3.3.6 / Nacos client 3.1.1. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>

    <!-- D-136: ArchUnit — architecture rule enforcement (DDD layering, no cycles). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>

    <!-- ===== test scope ===== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.14.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.18.0</version>
      <scope>test</scope>
    </dependency>
    <!-- H2 for in-memory JPA tests (no real MySQL needed in CI).
         D-119: H2 stays as the fast-path datasource for unit tests; the
         Testcontainers IT uses a real MySQL container (TiDB-compatible). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- D-119: Testcontainers — real isolated MySQL containers for integration
         tests. Versions are managed by the Spring Boot 4.0.7 BOM
         (testcontainers 2.0.5). The `testcontainers` JUnit group annotation
         is used so tests can be filtered by tag (see maven-surefire-plugin
         excludedGroups below). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>1.20.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <version>1.20.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>1.20.4</version>
      <scope>test</scope>
    </dependency>
    <!-- spring-boot-testcontainers provides @ServiceConnection auto-wiring for
         containers (D-119). BOM-managed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- D-119: Spring Cloud Contract consumer support — runs the generated
         WireMock stubs from payment-platform's contracts in OrderServiceContractTest.
         Version managed by spring-cloud-dependencies 2025.1.2 (contract 5.0.3). -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-contract-stub-runner</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- D-225: PostgreSQL driver for CockroachDB (PG wire) on the
         applications-cluster (TiDB absent; jdbc:postgresql URL via env). -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- classifier=exec so the BFF (and any consumer) can depend on the
               plain (repackaged=false) jar for the Dubbo interface/DTO classes
               while the fat runnable jar gets the -exec suffix. -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- D-119: Testcontainers ITs are tagged "testcontainers" so CI fast
               runs can exclude them with -DexcludedGroups=testcontainers,live.
               Unit tests (no Docker) still run by default. -->
          <excludedGroups>live,contract</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <!-- D-137: Coverage gate. haltOnFailure=false keeps Maven advisory locally;
               CI (java-test.yml coverage-gate job) enforces the hard 50% gate. -->
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <haltOnFailure>false</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.50</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- D-040: GraalVM Native Image support -->
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <version>0.10.4</version>
        <configuration>
          <buildArgs>
            <buildArg>--enable-preview</buildArg>
            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
            <buildArg>--initialize-at-build-time=org.slf4j,com.fasterxml.jackson</buildArg>
            <buildArg>--trace-class-initialization=com.ep.**</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- D-115: JIB container image build profile.
       Activated with: mvn compile jib:build -Pjib-build
       Shared profile snippet: deploy/build/jib-pom-profile.xml
       Image: harbor.edu.internal/education-platform/order-platform-service:1.0.0 -->
  <profiles>
    <profile>
      <id>jib-build</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <version>3.4.4</version>
            <configuration>
              <to>
                <image>harbor.edu.internal/education-platform/${project.artifactId}:${project.version}</image>
              </to>
              <from>
                <image>eclipse-temurin:21-jre-alpine</image>
              </from>
              <container>
                <ports>
                  <port>${jib.container.port}</port>
                </ports>
                <jvmFlags>
                  <jvmFlag>-XX:+UseZGC</jvmFlag>
                  <jvmFlag>-XX:+ZGenerational</jvmFlag>
                  <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                  <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
                </jvmFlags>
                <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                <labels>
                  <org.opencontainers.image.source>${env.GIT_URL}</org.opencontainers.image.source>
                  <org.opencontainers.image.revision>${env.GIT_COMMIT}</org.opencontainers.image.revision>
                  <maintained-by>gitops</maintained-by>
                </labels>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

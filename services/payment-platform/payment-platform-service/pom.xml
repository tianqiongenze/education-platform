<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ep</groupId>
    <artifactId>payment-platform</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>payment-platform-service</artifactId>
  <packaging>jar</packaging>
  <name>SP03 Payment Service</name>

  <properties>
    <!-- D-115: JIB build port (payment-platform-service listens on 8087). -->
    <jib.container.port>8087</jib.container.port>
  </properties>

  <dependencies>
    <!-- Thin API jar: PaymentService, Payment, Refund, records, enums, PaymentChannelSpi -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>payment-platform-api</artifactId>
    </dependency>

    <!-- ep-web-common: shared RoleChecker / ForbiddenException / ErrorResponse /
         GlobalExceptionHandler (version from parent dependencyManagement). -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>ep-web-common</artifactId>
    </dependency>

    <!-- Web: exclude Tomcat, use Jetty (consistency with other EP services) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-tomcat</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jetty</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- P1-4: Actuator endpoint security (HTTP Basic for /actuator/** non-health/info). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- P2-9: Bean Validation (@Valid + @Validated on request DTOs). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- P2-10: Resilience4j RateLimiter (opt-in via @RateLimiter annotation). -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.2.0</version>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Dubbo (RPC for order-platform-service to call PaymentService remotely) -->
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-spring-boot-starter</artifactId>
      <version>${dubbo.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo</artifactId>
      <version>${dubbo.version}</version>
    </dependency>
    <!-- Nacos client (registry; address N/A keeps Dubbo from bootstrapping a
         real registry in dev/CI but the dependency must be on the classpath). -->
    <dependency>
      <groupId>com.alibaba.nacos</groupId>
      <artifactId>nacos-client</artifactId>
      <version>3.1.1</version>
    </dependency>

    <!-- Jackson -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.19.4</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.19.4</version>
    </dependency>

    <!-- D-132: JPA + MySQL — replaces the in-memory ConcurrentHashMap storage in
         PaymentServiceImpl with TiDB-backed persistence (ep_payment / ep_refund).
         Mirrors the order-platform-service dependency layout. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- swagger-models-jakarta (OpenAPI component models) -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-models-jakarta</artifactId>
      <version>2.2.36</version>
    </dependency>

    <!-- Logging (logstash JSON encoder for structured logs) -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>8.0</version>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- D-136: ArchUnit — architecture rule enforcement (DDD layering, no cycles). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.5.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.14.4</version>
      <scope>test</scope>
    </dependency>
    <!-- D-132: H2 for in-memory JPA tests / Spring context boot when no real
         datasource is configured (e.g. the contract verifier base class).
         The Testcontainers IT overrides this with a real MySQL container. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.18.0</version>
      <scope>test</scope>
    </dependency>

    <!-- D-119: Testcontainers — isolated MySQL container for the payment IT.
         Versions managed by the Spring Boot 4.0.7 BOM (testcontainers 2.0.5).
         PaymentServiceImpl currently uses a ConcurrentHashMap (D-039); the IT
         still spins up a real MySQL to validate the service boots and works
         when real infra is available, and to exercise the MockPaymentChannel
         flow end-to-end. The production TiDB-backed repository swap
         (SDD §3.2) is designed but not yet wired. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>1.20.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <version>1.20.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>1.20.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- D-119: Spring Cloud Contract producer (verifier). The
         spring-cloud-contract-maven-plugin (below) generates WireMock stubs
         from the Groovy contracts in src/test/resources/contracts/ and
         publishes them as a stubs jar. Version managed by
         spring-cloud-dependencies 2025.1.2 (contract 5.0.3). -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-contract-verifier</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- D-119: RestAssured MockMvc is used by the contract verifier base class
         (PaymentServiceContractBase) to set up the MockMvc standalone context.
         Version managed by spring-cloud-contract-dependencies. -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>spring-mock-mvc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
      <!-- D-040: GraalVM Native Image support -->
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- D-119: Testcontainers ITs are tagged "testcontainers" so CI fast
               runs can exclude them with -DexcludedGroups=testcontainers,live.
               Unit tests (no Docker) still run by default. -->
          <excludedGroups>live,contract</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- D-137: Coverage gate. haltOnFailure=false keeps Maven advisory locally;
               CI (java-test.yml coverage-gate job) enforces the hard 50% gate. -->
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <haltOnFailure>false</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.50</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- D-119: Spring Cloud Contract producer plugin. Generates WireMock
           stubs from the Groovy contracts in src/test/resources/contracts/
           and packages them as a stubs jar so the consumer
           (order-platform-service) can verify its side of the contract via
           @AutoConfigureStubRunner. The contracts define the HTTP shape of
           the payment create + refund endpoints. -->
      <plugin>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-contract-maven-plugin</artifactId>
        <version>5.0.3</version>
        <configuration>
          <!-- Base test class for the generated contract verifier tests. -->
          <baseClassMappings>
            <baseClassMapping>
              <contractPackageRegex>.*contracts.*</contractPackageRegex>
              <baseClassFQN>com.ep.payment.PaymentServiceContractBase</baseClassFQN>
            </baseClassMapping>
          </baseClassMappings>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>convert</goal>
              <goal>generateStubs</goal>
              <goal>generateTests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- D-115: JIB container image build profile.
       Activated with: mvn compile jib:build -Pjib-build
       Shared profile snippet: deploy/build/jib-pom-profile.xml
       Image: harbor.edu.internal/education-platform/payment-platform-service:1.0.0 -->
  <profiles>
    <profile>
      <id>jib-build</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <version>3.4.4</version>
            <configuration>
              <to>
                <image>harbor.edu.internal/education-platform/${project.artifactId}:${project.version}</image>
              </to>
              <from>
                <image>eclipse-temurin:21-jre-alpine</image>
              </from>
              <container>
                <ports>
                  <port>${jib.container.port}</port>
                </ports>
                <jvmFlags>
                  <jvmFlag>-XX:+UseZGC</jvmFlag>
                  <jvmFlag>-XX:+ZGenerational</jvmFlag>
                  <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                  <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
                </jvmFlags>
                <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                <labels>
                  <org.opencontainers.image.source>${env.GIT_URL}</org.opencontainers.image.source>
                  <org.opencontainers.image.revision>${env.GIT_COMMIT}</org.opencontainers.image.revision>
                  <maintained-by>gitops</maintained-by>
                </labels>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

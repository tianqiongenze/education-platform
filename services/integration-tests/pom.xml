<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.ep</groupId>
    <artifactId>integration-tests</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>integration-tests</name>
    <description>Cross-service integration tests for the education-platform</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <dubbo.version>3.3.6</dubbo.version>
        <seata.version>2.0.0</seata.version>
        <redisson.version>3.51.0</redisson.version>
    </properties>

    <dependencies>
        <!-- D-048/P1-3: Seata distributed transaction support (declared for
             cross-service rollback tests; Seata TC must be running for live runs) -->
        <dependency>
            <groupId>io.seata</groupId>
            <artifactId>seata-spring-boot-starter</artifactId>
            <version>${seata.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.seata</groupId>
            <artifactId>seata-test</artifactId>
            <version>${seata.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Gap 1: TiDB JDBC connectivity (MySQL protocol on port 4000) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Gap 1: Redisson client for Redis Cluster live integration tests -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
            <version>${dubbo.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- D-067: Production service modules — referenced by the reflection-based
             CrossServiceContractTest and the real-interface-backed fakes so the
             integration test suite fails to compile if the production controllers /
             service interfaces drift from the documented contract. -->
        <dependency>
            <groupId>com.ep</groupId>
            <artifactId>core-business</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.ep</groupId>
            <artifactId>portal-bff</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.ep</groupId>
            <artifactId>grading-service</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <!-- D-138: order-platform — OrderController referenced by CrossServiceContractTest -->
        <dependency>
            <groupId>com.ep</groupId>
            <artifactId>order-platform-service</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <!-- Gap 1: live tests must NOT run during default `mvn test` -->
                    <excludedGroups>live</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- Gap 1: live IT classes run during `mvn verify` -->
                    <groups>live</groups>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- D-040: GraalVM Native Image support (declared only, not activated for test module) -->
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <version>0.10.4</version>
                <configuration>
                    <buildArgs>
                        <buildArg>--enable-preview</buildArg>
                        <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                        <buildArg>--initialize-at-build-time=org.slf4j,com.fasterxml.jackson</buildArg>
                        <buildArg>--trace-class-initialization=com.ep.**</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
  </parent>
  <groupId>com.ep</groupId>
  <artifactId>portal-bff</artifactId>
  <version>1.0.0</version>
  <properties>
    <java.version>21</java.version>
    <dubbo.version>3.3.6</dubbo.version>
    <nacos.client.version>3.1.1</nacos.client.version>
    <!-- D-115: JIB build port (portal-bff listens on 8090). -->
    <jib.container.port>8090</jib.container.port>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>grading-api</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>core-business</artifactId>
      <version>1.0.0</version>
    </dependency>
    <!-- D-order-extract: Order domain extracted into order-platform middle platform.
         BFF now consumes Order Dubbo API (OrderService, OrderDto, CreateOrderCmd)
         from order-platform-api instead of core-business. core-business kept for
         Course/User Dubbo interfaces. -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>order-platform-api</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>grading-service</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-tomcat</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jetty</artifactId>
    </dependency>
    <!-- D-032: Dubbo 3.3.6 + Spring Cloud Alibaba (NOT Netflix) -->
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-spring-boot-starter</artifactId>
      <version>${dubbo.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.dubbo</groupId>
      <artifactId>dubbo-registry-nacos</artifactId>
      <version>${dubbo.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.nacos</groupId>
      <artifactId>nacos-client</artifactId>
      <version>${nacos.client.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- P1-4: Actuator endpoint security (HTTP Basic for /actuator/** non-health/info). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- P2-9: Bean Validation (@Valid + @Validated on proxy DTOs). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- P2-10: Resilience4j RateLimiter (@RateLimiter on ProxyController). -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>2.2.0</version>
    </dependency>
    <!-- ep-web-common: ActuatorSecurityAutoConfiguration + RateLimitAutoConfiguration +
         GlobalExceptionHandler (validation error handling). -->
    <dependency>
      <groupId>com.ep</groupId>
      <artifactId>ep-web-common</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- D-076: gson required by Dubbo 3.3.6 / Nacos client 3.1.1 -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    <!-- D-070: springdoc-openapi replaced with swagger-models-jakarta directly (same as sp03/sp05).
         springdoc references org.springframework.data.util.TypeInformation which SB4/Hibernate7 moved,
         causing NoClassDefFoundError during Dubbo bean scanning. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-models-jakarta</artifactId>
      <version>2.2.36</version>
    </dependency>
    <!-- D-070: Structured JSON logging for Loki/ELK ingestion -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>8.0</version>
    </dependency>
    <!-- D-006 (Iron Law 1): Redis-backed session state for CellRouter.
         RouteContext misroute counter + WriteHoldRegistry must live in Redis so
         they survive cell hops in multi-cell deployment. Spring Boot auto-configures
         a StringRedisTemplate (Lettuce driver) when this starter is present. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- D-136: ArchUnit — architecture rule enforcement (layering, no cycles). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <!-- D-137: Coverage gate. haltOnFailure=false keeps Maven advisory locally;
               CI (java-test.yml coverage-gate job) enforces the hard 50% gate. -->
          <execution>
            <id>jacoco-check</id>
            <goals><goal>check</goal></goals>
            <phase>test</phase>
            <configuration>
              <haltOnFailure>false</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.50</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- D-040: GraalVM Native Image support -->
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <version>0.10.4</version>
        <configuration>
          <buildArgs>
            <buildArg>--enable-preview</buildArg>
            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
            <buildArg>--initialize-at-build-time=org.slf4j,com.fasterxml.jackson</buildArg>
            <buildArg>--trace-class-initialization=com.ep.**</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- D-115: JIB container image build profile.
       Activated with: mvn compile jib:build -Pjib-build
       Shared profile snippet: deploy/build/jib-pom-profile.xml
       Image: harbor.edu.internal/education-platform/portal-bff:1.0.0 -->
  <profiles>
    <profile>
      <id>jib-build</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <version>3.4.4</version>
            <configuration>
              <to>
                <image>harbor.edu.internal/education-platform/${project.artifactId}:${project.version}</image>
              </to>
              <from>
                <image>eclipse-temurin:21-jre-alpine</image>
              </from>
              <container>
                <ports>
                  <port>${jib.container.port}</port>
                </ports>
                <jvmFlags>
                  <jvmFlag>-XX:+UseZGC</jvmFlag>
                  <jvmFlag>-XX:+ZGenerational</jvmFlag>
                  <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                  <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
                </jvmFlags>
                <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                <labels>
                  <org.opencontainers.image.source>${env.GIT_URL}</org.opencontainers.image.source>
                  <org.opencontainers.image.revision>${env.GIT_COMMIT}</org.opencontainers.image.revision>
                  <maintained-by>gitops</maintained-by>
                </labels>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
